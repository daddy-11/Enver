# ==============================================================================
# ENVER AI TECH — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your secret values.
# NEVER commit your actual .env file with secrets into version control.
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=production

# Email Delivery — Microsoft Enterprise Mail (Microsoft Graph API & Microsoft 365)
# Uses Microsoft Entra ID (Azure AD) Client Credentials for sovereign enterprise email delivery
AZURE_CLIENT_ID=6cae09cb-4819-4ddc-8a98-13c5c7bf58ec
AZURE_TENANT_ID=bda1a0ee-c558-4d13-a112-18b2d8d1deba
AZURE_CLIENT_SECRET=your_azure_client_secret_here
MICROSOFT_SENDER_EMAIL=hanabi@enveraitech.com
VITE_AZURE_CLIENT_ID=6cae09cb-4819-4ddc-8a98-13c5c7bf58ec
VITE_AZURE_TENANT_ID=bda1a0ee-c558-4d13-a112-18b2d8d1deba

# AI Model Inference & Autonomous Multi-Agent Orchestration (Server Side Only)
# System 1 Reflex Classifier (<50ms): TypeSafe AI (Jev)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Autonomous Scraper & Explorer Agent: xAI Grok-4.6 on Microsoft Azure AI Foundry
AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_AI_KEY=your_azure_ai_key_here
AZURE_AI_PROJECT_URL=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL=grok-4.6

# System 2 Main Reasoning Engine: Google Gemini 3.5 Flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# Client Analytics & Telemetry (Public)
VITE_ANALYTICS_ENDPOINT=https://enveraitech.com
VITE_ANALYTICS_WEBSITE_ID=enveraitech-prod

# Firebase Client Configuration (Optional - Public OAuth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
