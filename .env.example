# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Database (Drizzle + Better Auth) ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_char_random_secret
BETTER_AUTH_URL=http://localhost:3000

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# Create a Redis DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Resend (contact form email) ───────────────────────────────────────────────
# https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY=re_your_resend_api_key

# ── OpenAI (resume embedding pipeline) ───────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_key

# ─────────────────────────────────────────────────────────────────────────────
# enveraitech.in — Internal workspace ("the digital playground")
# ─────────────────────────────────────────────────────────────────────────────

# Restrict ALL account creation to the allowlisted team. Set "true" only on the
# internal enveraitech.in deployment.
INTERNAL_ONLY_AUTH=true

# ── Google Workspace SSO (OAuth client for enveraitech.in) ───────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── Supabase Realtime (JWT minting for team channels) ────────────────────────
# Supabase dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ── AI providers (Tethys / Shorekeeper agents; metered server-side) ──────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
NVIDIA_API_KEY=your_nvidia_nim_key
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
FREEMODEL_API_KEY=your_freemodel_key
TETHYS_API_BASE=https://cc.freemodel.dev/v1
TETHYS_MODEL=claude-sonnet-4-6

# ── Google Cloud Billing export (admin portal, org-level real $) ─────────────
# Read-only service account JSON (or path); BigQuery billing export dataset.
GCP_BILLING_PROJECT_ID=your_gcp_project_id
GCP_BILLING_DATASET=billing_export
GCP_BILLING_TABLE=gcp_billing_export_v1_XXXXXX
GOOGLE_APPLICATION_CREDENTIALS_JSON=your_readonly_service_account_json
